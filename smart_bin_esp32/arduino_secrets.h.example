// Template for arduino_secrets.h.
//
// Copy this file to arduino_secrets.h in the same folder and replace the
// placeholders with the WiFi credentials for the bin's network. The real
// arduino_secrets.h is gitignored so credentials never reach the repository.
//
//   cp arduino_secrets.h.example arduino_secrets.h
//
#ifndef ARDUINO_SECRETS_H
#define ARDUINO_SECRETS_H

#define WIFI_SSID_VALUE     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD_VALUE "YOUR_WIFI_PASSWORD"

#endif
